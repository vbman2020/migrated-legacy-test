# Database Configuration
DATABASE_URL=postgresql://realworld:realworld_secret@localhost:5432/realworld
POSTGRES_USER=realworld
POSTGRES_PASSWORD=realworld_secret
POSTGRES_DB=realworld

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
PROJECT_NAME=RealWorld FastAPI

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080

# PGAdmin Configuration (optional)
PGADMIN_EMAIL=admin@realworld.com
PGADMIN_PASSWORD=admin

# Logging
LOG_LEVEL=INFO

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting (if implemented)
RATE_LIMIT_PER_MINUTE=60